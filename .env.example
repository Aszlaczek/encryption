# Skopiuj ten plik do `.env` i uzupełnij lokalnie.
# `.env` jest ignorowany przez Git. W repozytorium wolno trzymać wyłącznie placeholdery.

POSTGRES_DB=encryption
POSTGRES_USER=encryption
POSTGRES_PASSWORD=change-me

# Backend uruchamiany lokalnie, poza Compose. W Compose DB_URL jest zawsze
# ustawiany na nazwę serwisu `db`, a te wartości są ignorowane.
DB_URL=jdbc:postgresql://localhost:5432/encryption
DB_USERNAME=encryption
DB_PASSWORD=change-me

# Klucz AES-256 w base64 (32 bajty). Wygeneruj: openssl rand -base64 32
# Jeśli pozostanie pusty lub nie zostanie ustawiony, Compose użyje stałego
# klucza demo (wyłącznie do środowiska demonstracyjnego).
# Zmiana klucza po zapisaniu wiadomości uniemożliwi ich odszyfrowanie.
# W repozytorium pozostaje pusty; uzupełnij tylko w lokalnym `.env`.
APP_CRYPTO_KEY=
