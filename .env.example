# Skopiuj ten plik do `.env` i uzupełnij lokalnie.
# `.env` jest ignorowany przez Git. W repozytorium wolno trzymać wyłącznie placeholdery.

POSTGRES_DB=encryption
POSTGRES_USER=encryption
POSTGRES_PASSWORD=change-me

# Backend uruchamiany lokalnie, poza Compose. W Compose DB_URL jest zawsze
# ustawiany na nazwę serwisu `db`, a te wartości są ignorowane.
DB_URL=jdbc:postgresql://localhost:5432/encryption
DB_USERNAME=encryption
DB_PASSWORD=change-me

# Klucz AES-256 w base64 (32 bajty). Wygeneruj raz:
#   ./scripts/generate-crypto-key.sh
# Plik jest ignorowany przez Git i montowany tylko do backendu jako sekret.
# Zmiana lub utrata klucza po zapisaniu wiadomości uniemożliwi ich odszyfrowanie.
# W repozytorium pozostaje wyłącznie ścieżka, nigdy materiał klucza.
CRYPTO_KEY_FILE=./.secrets/crypto.key
APP_CRYPTO_KEY_ID=k1

# Ustaw `true` dopiero za HTTPS. Lokalne HTTP wymaga `false`, inaczej
# przeglądarka nie odeśle cookie JSESSIONID ani XSRF-TOKEN.
SESSION_COOKIE_SECURE=false
